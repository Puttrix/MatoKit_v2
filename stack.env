# Default values for containerized deployments (e.g., Portainer stacks)
# Override these via Portainer's environment settings or a local `.env` file as needed.
MATOKIT_IMAGE=ghcr.io/puttrix/matokit-api:latest
MATOMO_BASE_URL=https://matomo.example.com
MATOMO_TOKEN=token_auth_here
MATOMO_DEFAULT_SITE_ID=1
# Optional multi-site catalog (sequential indexes starting at 0)
#MATOKIT_SITE_0_ID=1
#MATOKIT_SITE_0_NAME=Marketing Site
#MATOKIT_SITE_1_ID=2
#MATOKIT_SITE_1_NAME=Blog
# Set via secret store before deploying (e.g., openssl rand -hex 32)
OPAL_BEARER_TOKEN=change-me
PORT=3000
